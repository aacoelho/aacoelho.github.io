---
/** Former 404.html + _layouts/404.html */
import NotFound from "../layouts/NotFound.astro";
---

<NotFound>
  <div class="landingSection">
    <div class="landingSection_top">
      <h1 class="landingSection_top_title f_displayExtra">404</h1>
    </div>

    <p class="landingSection_slogan f_textExtra">The page you were looking for doesn’t exist.</p>

    <div class="landingSection_corner">
      <a class="f_textBig f_textBig-link  link_transition landingSection_link" href="/">Go Home</a>
    </div>
  </div>
</NotFound>
